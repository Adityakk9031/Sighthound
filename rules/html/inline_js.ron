{
    inline_event_handlers: [
        // Basic inline event handlers
        (
            pattern: "onclick",
            finding_type: "inline_onclick_handler",
            severity: "medium",
            confidence: "high",
            conditions: [
                (type: "has_argument", patterns: ["*eval(*", "*document.*", "*window.*"]),
            ],
        ),
        (
            pattern: "onload",
            finding_type: "inline_onload_handler", 
            severity: "medium",
            confidence: "high",
            conditions: [
                (type: "has_argument", patterns: ["*eval(*", "*document.*", "*window.*"]),
            ],
        ),
        (
            pattern: "onerror",
            finding_type: "inline_onerror_handler",
            severity: "medium", 
            confidence: "high",
            conditions: [
                (type: "has_argument", patterns: ["*eval(*", "*document.*", "*window.*"]),
            ],
        ),
        (
            pattern: "onmouseover",
            finding_type: "inline_mouseover_handler",
            severity: "medium",
            confidence: "high", 
            conditions: [
                (type: "has_argument", patterns: ["*eval(*", "*document.*", "*window.*"]),
            ],
        ),
    ],

    javascript_urls: [
        // href with javascript: protocol
        (
            pattern: "href",
            finding_type: "javascript_url",
            severity: "medium",
            confidence: "high",
            conditions: [
                (type: "has_argument", patterns: ["*javascript:*"]),
            ],
        ),
        // form action with javascript: protocol
        (
            pattern: "action", 
            finding_type: "javascript_form_action",
            severity: "high",
            confidence: "high",
            conditions: [
                (type: "has_argument", patterns: ["*javascript:*"]),
            ],
        ),
        // src attributes with javascript: protocol
        (
            pattern: "src",
            finding_type: "javascript_src",
            severity: "high",
            confidence: "high",
            conditions: [
                (type: "has_argument", patterns: ["*javascript:*"]),
            ],
        ),
    ],

    script_injection: [
        // Inline script tags with dynamic content 
        (
            pattern: "script",
            finding_type: "inline_script_injection",
            severity: "high",
            confidence: "medium",
            conditions: [
                (type: "has_argument", patterns: ["*document.write*", "*eval(*", "*innerHTML*"]),
            ],
        ),
    ],

    dangerous_attributes: [
        // srcdoc attribute with HTML content
        (
            pattern: "srcdoc",
            finding_type: "iframe_srcdoc_injection",
            severity: "high",
            confidence: "medium",
            conditions: [
                (type: "has_argument", patterns: ["*<script*", "*javascript:*", "*on*=*"]),
            ],
        ),
        // data URLs with HTML/JavaScript content
        (
            pattern: "src",
            finding_type: "data_url_src_injection", 
            severity: "medium",
            confidence: "high",
            conditions: [
                (type: "has_argument", patterns: ["*data:text/html*", "*data:application/javascript*"]),
            ],
        ),
        (
            pattern: "href",
            finding_type: "data_url_href_injection",
            severity: "medium",
            confidence: "high", 
            conditions: [
                (type: "has_argument", patterns: ["*data:text/html*", "*data:application/javascript*"]),
            ],
        ),
    ],

    meta_injection: [
        // Meta refresh with URL redirection
        (
            pattern: "content",
            finding_type: "meta_refresh_injection",
            severity: "medium",
            confidence: "medium",
            conditions: [
                (type: "has_argument", patterns: ["*url=javascript:*", "*url=data:*"]),
            ],
        ),
    ],

    style_injection: [
        // CSS expression (IE vulnerability)
        (
            pattern: "style",
            finding_type: "css_expression_injection",
            severity: "medium",
            confidence: "high",
            conditions: [
                (type: "has_argument", patterns: ["*expression(*"]),
            ],
        ),
    ],
} 