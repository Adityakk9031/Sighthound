        // ==================== DOM-based XSS (CWE-79) ====================
        (
            id: Some("js-dom-xss-001"),
            name: Some("DOM XSS via innerHTML"),
            category: Some("xss"),
            mode: "search",
            patterns: Some([
                "*.innerHTML*=*"
            ]),
