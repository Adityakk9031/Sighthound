        // ==================== Open Redirect (CWE-601) ====================
        (
            id: Some("js-open-redirect-001"),
            name: Some("Open redirect via location"),
            category: Some("redirect"),
            mode: "search",
            patterns: Some([
                "*window.location*=*user*",
