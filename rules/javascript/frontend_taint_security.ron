(
    rules: [
        // ==================== CWE-79: DOM-based XSS ====================
        (
            id: Some("js-dom-xss-taint-001"),
            name: Some("DOM-based XSS via User Input"),
            category: Some("xss"),
            mode: "taint",
            
            sources: Some([
                // URL and location sources
                "window.location.hash",
                "window.location.search", 
                "window.location.href",
                "location.hash",
                "location.search",
                "location.href",
                "document.URL",
                "document.documentURI",
                "document.baseURI",
                
                // URL parameter parsing
                "URLSearchParams",
                "new URL",
                "decodeURIComponent",
                "decodeURI",
                
                // DOM input sources
                "*.value",
                "*.textContent", 
                "*.innerText",
                "*.innerHTML",
                "*.getAttribute",
                "*.dataset",
                
                // Form data
                "FormData",
                "*.files",
                "*.selectedOptions",
                
                // User interaction
                "prompt(",
                "confirm(",
                
                // PostMessage
                "event.data",
                "e.data",
                "message.data",
                
                // Storage (could contain user data)
                "localStorage.getItem",
                "sessionStorage.getItem",
                "*.cookie"
            ]),
            
            sinks: Some([
                // Direct DOM manipulation
                "*.innerHTML",
                "*.outerHTML", 
                "document.write",
                "document.writeln",
                "*.insertAdjacentHTML",
                
                // Script injection
                "*.src",
                "*.href",
                "document.createElement",
                
                // Eval-like functions
                "eval(",
                "Function(",
                "setTimeout(",
                "setInterval(",
                
                // Dynamic script loading
                "import(",
                "*.appendChild",
                "*.insertBefore"
            ]),
            
            sanitizers: Some([
                // HTML encoding
                "encodeHTML",
                "escapeHTML", 
                
                // Validation
                "DOMPurify.sanitize",
                "validator.escape",
                "sanitize(",
                "validate(",
                "clean(",
            ]),
            
            finding_type: Some("DOM-based XSS"),
            severity: Some("Critical"),
            confidence: Some("High"),
            
            description: Some("User-controlled data flows to DOM manipulation without proper sanitization, enabling XSS attacks"),
            
            file_types: Some((
                extensions: Some([".js", ".jsx", ".ts", ".tsx"]),
                exclude_patterns: Some(["*test*", "*spec*", "*mock*", "*.min.js"])
            )),
            
            tags: Some(["xss", "dom", "cwe-79", "frontend"])
        ),

        // ==================== CWE-80: Basic XSS ====================
        (
            id: Some("js-basic-xss-taint-001"),
            name: Some("Basic XSS via User Input"),
            category: Some("xss"),
            mode: "taint",
            
            sources: Some([
                // All DOM-based sources plus additional
                "window.location.*",
                "location.*",
                "document.URL",
                "document.referrer",
                "*.value",
                "*.textContent",
                "*.innerText", 
                "*.getAttribute",
                "FormData",
                "URLSearchParams",
                "prompt(",
                "event.data",
                "localStorage.*",
                "sessionStorage.*",
                "*.cookie",
                
                // Network sources
                "fetch(",
                "XMLHttpRequest",
                "*.responseText",
                "*.response",
                "axios.*",
                "$.get",
                "$.post",
                "$.ajax"
            ]),
            
            sinks: Some([
                // DOM sinks
                "*.innerHTML",
                "*.outerHTML",
                "document.write",
                "document.writeln",
                "*.insertAdjacentHTML",
                
                // Attribute sinks
                "*.src",
                "*.href", 
                "*.action",
                "*.formAction",
                "*.setAttribute",
                
                // Event handler sinks
                "*.onclick",
                "*.onload",
                "*.onerror",
                "addEventListener",
                
                // Template/rendering
                "template.innerHTML",
                "*.render",
                "*.compile"
            ]),
            
            sanitizers: Some([
                "DOMPurify.sanitize",
                "validator.escape",
                "encodeHTML",
                "escapeHTML",
                "sanitizeHTML"
            ]),
            
            finding_type: Some("Cross-Site Scripting"),
            severity: Some("High"),
            confidence: Some("High"),
            
            description: Some("User input flows to output context without proper encoding, enabling XSS attacks"),
            
            file_types: Some((
                extensions: Some([".js", ".jsx", ".ts", ".tsx"]),
                exclude_patterns: Some([
                    // Minified files
                    "*.min.js", "*.min.jsx", "*.min.ts", "*.min.tsx",
                    "*.bundle.js", "*.chunk.js", "*.vendor.js", 
                    "*-min.js", "*-bundle.js", "*-compiled.js",
                    
                    // Third-party library directories
                    "*/node_modules/*", "*/assets/*", "*/lib/*", "*/vendor/*",
                    "*/libraries/*", "*/deps/*", "*/dependencies/*",
                    
                    // Common library files by name
                    "*three.js", "*three.min.js", "*jquery*.js", "*bootstrap*.js",
                    "*angular*.js", "*react*.js", "*vue*.js", "*lodash*.js",
                    "*moment*.js", "*d3*.js", "*chart*.js", "*dat.gui*.js",
                    
                    // Test files
                    "*test*", "*spec*", "*mock*"
                ])
            )),
            
            tags: Some(["xss", "cwe-80", "frontend"])
        ),

        // ==================== CWE-200: Exposure of Sensitive Information ====================
        (
            id: Some("js-info-exposure-taint-001"),
            name: Some("Sensitive Information Exposure"),
            category: Some("information-disclosure"),
            mode: "taint",
            
            sources: Some([
                // User input sources (DOM elements)
                "document.getElementById(*).value",
                "document.querySelector('input[type=password]').value",
                "document.querySelector('input[name*=password]').value",
                "document.querySelector('input[name*=token]').value",
                "document.querySelector('input[name*=key]').value",
                "document.querySelector('*[type=password]').value",
                "document.getElementsByName('password')[0].value",
                "document.getElementsByName('token')[0].value",
                "document.forms.*.password.value",
                "document.forms.*.token.value",
                
                // URL/location sources with sensitive data
                "window.location.search",
                "window.location.hash",
                "new URLSearchParams(window.location.search).get('password')",
                "new URLSearchParams(window.location.search).get('token')",
                "new URLSearchParams(window.location.search).get('key')",
                
                // Storage sources
                "localStorage.getItem('password')",
                "localStorage.getItem('token')",
                "localStorage.getItem('apiKey')",
                "sessionStorage.getItem('password')",
                "sessionStorage.getItem('token')",
                "sessionStorage.getItem('apiKey')",
                "*.cookie",
                
                // Environment/config (server-side or Node.js)
                "process.env.PASSWORD",
                "process.env.TOKEN",
                "process.env.API_KEY",
                "process.env.SECRET",
                "config.password",
                "config.token",
                "config.apiKey",
                "settings.password",
                "settings.token"
            ]),
            
            sinks: Some([
                // Logging and debugging
                "console.log",
                "console.info", 
                "console.warn",
                "console.error",
                "console.debug",
                "console.trace",
                
                // Network transmission
                "fetch(",
                "XMLHttpRequest",
                "axios.*",
                "$.ajax",
                "$.get",
                "$.post",
                
                // URL construction
                "window.location",
                "location.href",
                "*.src",
                "*.href",
                
                // Storage (if different from source)
                "localStorage.setItem",
                "sessionStorage.setItem",
                
                // Error reporting
                "*.onerror",
                "addEventListener",
                "reportError"
            ]),
            
            sanitizers: Some([
                "redact(",
                "sanitize(",
                "mask(",
                "obfuscate(",
                "hash(",
                "encrypt(",
                "*.substring(0,",
                "*.slice(0,"
            ]),
            
            finding_type: Some("Information Disclosure"),
            severity: Some("High"),
            confidence: Some("Medium"),
            
            description: Some("Sensitive information may be exposed through logging, network requests, or URL parameters"),
            
            file_types: Some((
                extensions: Some([".js", ".jsx", ".ts", ".tsx"]),
                exclude_patterns: Some([
                    // Minified files
                    "*.min.js", "*.min.jsx", "*.min.ts", "*.min.tsx",
                    "*.bundle.js", "*.chunk.js", "*.vendor.js", 
                    "*-min.js", "*-bundle.js", "*-compiled.js",
                    
                    // Third-party library directories
                    "*/node_modules/*", "*/assets/*", "*/lib/*", "*/vendor/*",
                    "*/libraries/*", "*/deps/*", "*/dependencies/*",
                    
                    // Common library files by name
                    "*three.js", "*three.min.js", "*jquery*.js", "*bootstrap*.js",
                    "*angular*.js", "*react*.js", "*vue*.js", "*lodash*.js",
                    "*moment*.js", "*d3*.js", "*chart*.js", "*dat.gui*.js",
                    
                    // Test files
                    "*test*", "*spec*", "*mock*"
                ])
            )),
            
            tags: Some(["information-disclosure", "cwe-200", "sensitive-data"])
        ),

        // ==================== CWE-116: Improper Output Encoding ====================
        (
            id: Some("js-improper-encoding-taint-001"),
