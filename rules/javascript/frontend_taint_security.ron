        // ==================== CWE-927: Missing Origin Validation ====================
        (
            id: Some("js-missing-origin-validation-taint-001"),
            name: Some("Missing Origin Validation in postMessage"),
            category: Some("postmessage"),
            mode: "taint",
            
            sources: Some([
                "event.data",
                "e.data", 
                "message.data"
            ]),
            
            sinks: Some([
                // Any usage of postMessage data without origin check
                "eval(",
                "Function(",
                "*.innerHTML",
                "document.write",
                "*.src",
                "*.href",
                "localStorage.setItem",
                "sessionStorage.setItem",
                "window.location",
                "setTimeout(",
                "setInterval(",
                "import("
            ]),
            
            sanitizers: Some([
                // Must include origin validation
                "event.origin ===",
                "event.origin !==", 
                "e.origin ===",
                "e.origin !==",
                "message.origin ===",
                "checkOrigin(",
                "validateOrigin(",
                "isAllowedOrigin(",
                "allowedOrigins.includes",
                "trustedOrigins.includes"
            ]),
            
            finding_type: Some("Missing Origin Validation"),
            severity: Some("High"),
            confidence: Some("High"),
            
            description: Some("postMessage data is processed without validating the message origin"),
            
            file_types: Some((
                extensions: Some([".js", ".jsx", ".ts", ".tsx"]),
                exclude_patterns: Some([
                    // Minified files
                    "*.min.js", "*.min.jsx", "*.min.ts", "*.min.tsx",
                    "*.bundle.js", "*.chunk.js", "*.vendor.js", 
                    "*-min.js", "*-bundle.js", "*-compiled.js",
                    
                    // Third-party library directories
                    "*/node_modules/*", "*/assets/*", "*/lib/*", "*/vendor/*",
                    "*/libraries/*", "*/deps/*", "*/dependencies/*",
                    
                    // Common library files by name
                    "*three.js", "*three.min.js", "*jquery*.js", "*bootstrap*.js",
                    "*angular*.js", "*react*.js", "*vue*.js", "*lodash*.js",
                    "*moment*.js", "*d3*.js", "*chart*.js", "*dat.gui*.js",
                    
                    // Test files
                    "*test*", "*spec*", "*mock*"
                ])
            )),
            
            conditions: Some([
                (
                    field: "context",
                    operator: "not_contains",
                    value: "origin",
                    condition_type: Some("in_context")
                )
            ]),
            
            tags: Some(["postmessage", "cwe-927", "origin-validation"])
        ),

        // ==================== CWE-922: Insecure Storage ====================
        (
            id: Some("js-insecure-storage-taint-001"),
            name: Some("Insecure Storage of Sensitive Data"),
            category: Some("storage"),
            mode: "taint",
            
            sources: Some([
                // Actual sensitive data sources - API responses
                "*.responseJSON.token",
                "*.responseJSON.accessToken",
                "*.responseJSON.refreshToken",
                "*.responseJSON.apiKey",
                "*.responseJSON.sessionId",
                "*.response.data.token",
                "*.response.data.accessToken",
                "*.response.data.key",
                
                // Authentication form fields (actual values)
                "*[type=\"password\"].value",
                "*[name=\"password\"].value",
                "*[name=\"token\"].value",
                "*[name=\"apiKey\"].value",
                "*[name=\"secret\"].value",
                "*[id=\"password\"].value",
                "*[id=\"token\"].value",
                
                // JWT and authentication tokens
                "jwt.sign(",
                "generateToken(",
                "createToken(",
                "authToken",
                "bearerToken",
                
                // Cookie values containing sensitive data
                "document.cookie.match",
                "getCookie(*password*)",
                "getCookie(*token*)",
                "getCookie(*session*)",
                
                // Environment or config with sensitive data
                "process.env.API_KEY",
                "process.env.SECRET",
                "process.env.TOKEN",
                "config.apiKey",
                "config.secret",
                "config.privateKey",
                
                // User input that's clearly sensitive
                "prompt(*password*)",
                "prompt(*token*)",
                "prompt(*key*)",
                
                // Biometric/crypto data
                "*.privateKey",
                "*.publicKey",
                "crypto.generateKey",
                "generateKeyPair"
            ]),
            
            sinks: Some([
                // Insecure storage with sensitive data patterns
                "localStorage.setItem(*password*",
                "localStorage.setItem(*token*",
                "localStorage.setItem(*key*",
                "localStorage.setItem(*secret*",
                "localStorage.setItem(*session*",
                "sessionStorage.setItem(*password*",
                "sessionStorage.setItem(*token*",
                "sessionStorage.setItem(*key*",
                "sessionStorage.setItem(*secret*",
                "sessionStorage.setItem(*session*",
                
                // Generic storage sinks (will be filtered by sources)
                "localStorage.setItem",
                "sessionStorage.setItem",
                "document.cookie =",
                "*.cookie =",
                
                // IndexedDB storage of sensitive data
                "indexedDB.*.put",
                "indexedDB.*.add",
                "*.objectStore.put",
                "*.objectStore.add",
                
                // WebSQL (deprecated but still risky)
                "*.executeSql"
            ]),
            
            sanitizers: Some([
                // Cryptographic operations
                "encrypt(",
                "AES.encrypt(",
                "CryptoJS.AES.encrypt(",
                "crypto.subtle.encrypt(",
                "bcrypt.hash(",
                "scrypt(",
                "pbkdf2(",
                
                // Hashing
                "hash(",
                "sha256(",
                "md5(",
                "crypto.createHash(",
                
                // Secure storage libraries
                "secureStorage.setItem",
                "encryptedStorage.setItem",
                "secureLocalStorage.setItem",
                "cryptoStorage.set",
                
                // Tokenization/obfuscation
                "tokenize(",
                "obfuscate(",
                "mask(",
                "redact(",
                
                // Validation that indicates non-sensitive data
                "isPublic(",
                "isNonSensitive(",
                "isSafeToStore(",
                
                // JWT encoding (which includes some protection)
                "jwt.sign(",
                "jsonwebtoken.sign(",
                
