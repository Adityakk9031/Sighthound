{
    event_handler_injection: [
        (
            patterns: [
                "*.onclick",
                "*.onload",
                "*.onunload",
                "*.onmouseover",
                "*.onmouseout",
                "*.onfocus",
                "*.onblur",
                "*.onchange",
                "*.onsubmit"
            ],
            finding_type: "event_handler_injection",
            severity: "high",
            confidence: "high",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "in_context", not_in: ["comment", "string_literal"]),
                (type: "has_argument", patterns: ["*+*", "*concat*", "*$*", "*`*"]),
            ],
        ),
        (
            pattern: "*.setAttribute",
            finding_type: "event_handler_injection",
            severity: "high",
            confidence: "medium",
            conditions: [
                // First argument contains event handler name
                (type: "has_argument", patterns: ["*on*", "*ON*"]),
                // Second argument is dynamic
                (type: "not_literal", argument_position: 1),
                (type: "in_context", not_in: ["comment", "string_literal"]),
            ],
        ),
        (
            pattern: "*.addEventListener",
            finding_type: "event_listener_injection",
            severity: "medium",
            confidence: "low",
            conditions: [
                // Second argument (listener) should be a function, not string
                (type: "has_argument", patterns: ["*+*", "*concat*", "*eval*", "*Function*"]),
                (type: "not_literal", argument_position: 1),
                (type: "in_context", not_in: ["comment", "string_literal"]),
            ],
        ),
    ],
    
    dynamic_event_creation: [
        (
            pattern: "document.createEvent",
            finding_type: "dynamic_event_creation",
            severity: "low",
            confidence: "low",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "has_argument", patterns: ["*+*", "*concat*", "*$*", "*`*"]),
                (type: "in_context", not_in: ["comment", "string_literal"]),
            ],
        ),
    ],
    
    file_types: (
        extensions: [".js", ".jsx", ".mjs", ".ts"],
        exclude_patterns: ["*test*", "*spec*", "*mock*", "*__tests__*"],
    ),
} 