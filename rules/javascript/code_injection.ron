{
    code_injection_sinks: [
        (
            pattern: "eval",
            finding_type: "code_injection",
            severity: "critical",
            confidence: "high",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "in_context", not_in: ["comment", "string_literal"]),
            ],
        ),
        (
            patterns: [
                "Function",
                "new Function"
            ],
            finding_type: "code_injection",
            severity: "critical",
            confidence: "high",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "in_context", not_in: ["comment", "string_literal"]),
            ],
        ),
        (
            patterns: [
                "setTimeout",
                "setInterval"
            ],
            finding_type: "code_injection",
            severity: "high",
            confidence: "medium",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "in_context", not_in: ["comment", "string_literal"]),
                // Only flag string arguments, not function arguments
                (type: "has_argument", patterns: ["*+*", "*concat*", "*$*", "*`*"]),
            ],
        ),
        (
            pattern: "*.createElement",
            finding_type: "code_injection",
            severity: "high",
            confidence: "medium",
            conditions: [
                (type: "has_argument", patterns: ["*script*", "*SCRIPT*"]),
                (type: "not_literal", argument_position: 0),
                (type: "in_context", not_in: ["comment", "string_literal"]),
            ],
        ),
        (
            pattern: "execScript",
            finding_type: "code_injection",
            severity: "critical",
            confidence: "high",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "in_context", not_in: ["comment", "string_literal"]),
            ],
        ),
    ],
    
    dynamic_imports: [
        (
            patterns: [
                "import(",
                "importScripts"
            ],
            finding_type: "dynamic_code_loading",
            severity: "medium",
            confidence: "medium",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "has_argument", patterns: ["*+*", "*concat*", "*$*", "*`*"]),
                (type: "in_context", not_in: ["comment", "string_literal"]),
            ],
        ),
    ],
    
    file_types: (
        extensions: [".js", ".jsx", ".mjs", ".ts"],
        exclude_patterns: ["*test*", "*spec*", "*mock*", "*__tests__*", "*webpack*", "*build*"],
    ),
} 