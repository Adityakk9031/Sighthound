{
    dom_xss: [
        // Rule 1: Direct innerHTML assignments
        (
            patterns: [
                "innerHTML",
                "outerHTML",
                "insertAdjacentHTML"
            ],
            finding_type: "dom_xss",
            severity: "high",
            confidence: "high",
            conditions: [
                // Must be dynamic content (not hardcoded HTML)
                (type: "not_literal", argument_position: 0),
                // Look for user input patterns
                (type: "has_argument", patterns: [
                    "*user*", "*input*", "*request*", "*data*",
                    "*content*", "*html*", "*response*"
                ]),
                // Not sanitized with proper methods
                (type: "argument_not_sanitized", patterns: [
                    "*sanitize*", "*escape*", "*DOMPurify*", 
                    "*createTextNode*", "*textContent*"
                ]),
            ],
            sanitizers: [
                "DOMPurify.sanitize",
                "sanitizeHtml",
                "escapeHtml",
                "createTextNode",
                "textContent"
            ],
        ),

        // Rule 2: Dangerous DOM manipulation methods
        (
            patterns: [
                "document.write",
                "document.writeln",
                "document.open",
                "document.close"
            ],
            finding_type: "dom_xss",
            severity: "critical",
            confidence: "high",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "has_argument", patterns: [
                    "*user*", "*input*", "*request*", "*data*",
                    "*content*", "*html*", "*response*"
                ]),
            ],
        ),

        // Rule 3: Dynamic script execution
        (
            patterns: [
                "eval",
                "Function",
                "setTimeout",
                "setInterval"
            ],
            finding_type: "dom_xss",
            severity: "critical",
            confidence: "medium",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "has_argument", patterns: [
                    "*user*", "*input*", "*request*", "*data*",
                    "*content*", "*html*", "*response*"
                ]),
                // Exclude common legitimate uses
                (type: "argument_not_sanitized", patterns: [
                    "*JSON.parse*", "*parseInt*", "*parseFloat*"
                ]),
            ],
        ),

        // Rule 4: Template literal injection
        (
            patterns: [
                "`${",
                "`$",
                "`"
            ],
            finding_type: "dom_xss",
            severity: "high",
            confidence: "medium",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "has_argument", patterns: [
                    "*user*", "*input*", "*request*", "*data*",
                    "*content*", "*html*", "*response*"
                ]),
                // Look for HTML-related context
                (type: "in_context", patterns: [
                    "*innerHTML*", "*outerHTML*", "*insertAdjacentHTML*",
                    "*document.write*"
                ]),
            ],
        ),

        // Rule 5: URL manipulation
        (
            patterns: [
                "location.href",
                "location.assign",
                "location.replace",
                "window.open"
            ],
            finding_type: "dom_xss",
            severity: "high",
            confidence: "medium",
            conditions: [
                (type: "not_literal", argument_position: 0),
                (type: "has_argument", patterns: [
                    "*user*", "*input*", "*request*", "*data*",
                    "*content*", "*html*", "*response*"
                ]),
                // Exclude common legitimate uses
                (type: "argument_not_sanitized", patterns: [
                    "*encodeURI*", "*encodeURIComponent*", "*URL*"
                ]),
            ],
            sanitizers: [
                "encodeURI",
                "encodeURIComponent",
                "URL"
            ],
        ),
    ],
}