// Java vulnerability rules - Clean syntax version
{
    injection_sinks: [
        // SQL Injection - Basic detection
        (
            pattern: "*.execute",
            finding_type: "sql_injection",
            severity: "high",
            confidence: "medium",
            file_types: (
                extensions: [".java"],
            ),
        ),
        (
            pattern: "*.executeQuery",
            finding_type: "sql_injection",
            severity: "high",
            confidence: "medium",
            file_types: (
                extensions: [".java"],
            ),
        ),
        (
            pattern: "*.executeUpdate",
            finding_type: "sql_injection",
            severity: "high",
            confidence: "medium",
            file_types: (
                extensions: [".java"],
            ),
        ),
        // Command Injection - Basic detection
        (
            pattern: "Runtime.exec",
            finding_type: "command_injection",
            severity: "high",
            confidence: "high",
            file_types: (
                extensions: [".java"],
            ),
        ),
        (
            pattern: "*.exec",
            finding_type: "command_injection",
            severity: "high",
            confidence: "medium",
            file_types: (
                extensions: [".java"],
            ),
        ),
    ],  
    deserialization: [
        // Java ObjectInputStream deserialization - High Priority
        (
            pattern: "readObject",
            finding_type: "insecure_deserialization",
            severity: "critical",
            confidence: "high",
            file_types: (
                extensions: [".java"],
                include_patterns: ["*Controller*", "*Servlet*", "*Service*", "*Handler*", "*Endpoint*"],
            ),
        ),
        // ObjectInputStream constructor - Direct pattern  
        (
            pattern: "new ObjectInputStream",
            finding_type: "insecure_deserialization",
            severity: "high",
            confidence: "high",
            file_types: (
                extensions: [".java"],
                include_patterns: ["*Controller*", "*Servlet*", "*Service*", "*Handler*", "*Endpoint*"],
            ),
        ),
        // ByteArrayInputStream in web contexts
        (
            pattern: "new ByteArrayInputStream",
            finding_type: "insecure_deserialization",
            severity: "medium",
            confidence: "medium",
            file_types: (
                extensions: [".java"],
                include_patterns: ["*Controller*", "*Servlet*", "*Service*", "*Handler*", "*Endpoint*"],
            ),
        ),
        // XMLDecoder deserialization vulnerability
        (
            pattern: "new XMLDecoder",
            finding_type: "insecure_deserialization",
            severity: "high",
            confidence: "high",
            file_types: (
                extensions: [".java"],
            ),
        ),
        (
            pattern: "XMLDecoder.readObject",
            finding_type: "insecure_deserialization",
            severity: "high",
            confidence: "high",
            file_types: (
                extensions: [".java"],
            ),
        ),
        // Jackson deserialization vulnerability
        (
            pattern: "ObjectMapper.readValue",
            finding_type: "insecure_deserialization",
            severity: "medium",
            confidence: "medium",
            file_types: (
                extensions: [".java"],
            ),
        ),
        (
            pattern: "*.readValue",
            finding_type: "insecure_deserialization",
            severity: "medium",
            confidence: "low",
            file_types: (
                extensions: [".java"],
                include_patterns: ["*Controller*", "*Servlet*", "*Service*"],
            ),
        ),
        // Gson deserialization vulnerability
        (
            pattern: "Gson.fromJson",
            finding_type: "insecure_deserialization",
            severity: "medium",
            confidence: "medium",
            file_types: (
                extensions: [".java"],
            ),
        ),
        (
            pattern: "*.fromJson",
            finding_type: "insecure_deserialization",
            severity: "medium",
            confidence: "low",
            file_types: (
                extensions: [".java"],
                include_patterns: ["*Controller*", "*Servlet*", "*Service*"],
            ),
        ),
        // XStream deserialization vulnerability
        (
            pattern: "XStream.fromXML",
            finding_type: "insecure_deserialization",
            severity: "high",
            confidence: "high",
            file_types: (
                extensions: [".java"],
            ),
        ),
        (
            pattern: "*.fromXML",
            finding_type: "insecure_deserialization",
            severity: "high",
            confidence: "medium",
            file_types: (
                extensions: [".java"],
                include_patterns: ["*Controller*", "*Servlet*", "*Service*"],
            ),
        ),
    ],
    crypto_rules: [
        // Weak encryption algorithms
        (
            pattern: "Cipher.getInstance",
            finding_type: "weak_crypto",
            severity: "high",
            confidence: "medium",
            file_types: (
                extensions: [".java"],
            ),
        ),
        // Weak hash algorithms
        (
            pattern: "MessageDigest.getInstance",
            finding_type: "weak_crypto",
            severity: "medium",
            confidence: "high",
            file_types: (
                extensions: [".java"],
            ),
        ),
    ]
}
