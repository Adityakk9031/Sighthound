(
    rules: [
        (
            id: Some("python-sql-injection-001"),
            name: Some("SQL Injection via String Formatting"),
            category: Some("database"),
            mode: "search",
            patterns: Some([
                "*cursor.execute*%*",
                "*connection.execute*%*",
                "*db.execute*%*",
                "*session.execute*%*"
            ]),
            finding_type: Some("SQL String Formatting"),
            severity: Some("Critical"),
            confidence: Some("High"),
            description: Some("SQL query constructed using string formatting, which is vulnerable to SQL injection attacks"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["sql", "injection", "database", "critical"])
        ),
        (
            id: Some("python-sql-injection-002"),
            name: Some("SQL Injection via String Concatenation"),
            category: Some("database"),
            mode: "search",
            patterns: Some([
                "*cursor.execute(*+*",
                "*connection.execute(*+*",
                "*db.execute(*+*",
