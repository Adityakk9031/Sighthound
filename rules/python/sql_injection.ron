            tags: Some(["sql", "injection", "database", "critical"])
        ),
        (
            id: Some("python-sql-execution-database"),
            name: Some("Database SQL Execution"),
            category: Some("database"),
            mode: "search",
            patterns: Some([
                "*cursor.execute(*",
                "*connection.execute(*",
                "*db.execute(*",
                "*session.execute(*"
            ]),
            finding_type: Some("SQL Execution"),
            severity: Some("Medium"),
            confidence: Some("Medium"),
            description: Some("Database SQL execution detected - ensure parameterized queries are used to prevent injection"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["sql", "database", "execution"])
        ),
        (
            id: Some("python-sql-dangerous-keywords"),
            name: Some("Dangerous SQL Keywords"),
            category: Some("database"),
            mode: "search",
            patterns: Some([
                "*DROP TABLE*",
                "*DELETE FROM*",
                "*UNION SELECT*",
                "*; DROP*",
                "*; DELETE*"
            ]),
            finding_type: Some("Dangerous SQL"),
            severity: Some("High"),
            confidence: Some("High"),
            description: Some("Dangerous SQL keywords detected that could indicate SQL injection attempts"),
            file_types: Some((
