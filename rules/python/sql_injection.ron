(
    rules: [
        (
            id: Some("python-sql-injection-001"),
            name: Some("SQL Injection via String Formatting"),
            category: Some("injection"),
            mode: "search",
            patterns: Some([
                "*cursor.execute*%*",
                "*execute*%*",
                "*\"*%*\"*%*",
                "*'*%*'*%*"
            ]),
            finding_type: Some("SQL Injection"),
            severity: Some("Critical"),
            confidence: Some("High"),
            description: Some("SQL query constructed using string formatting, which is vulnerable to SQL injection attacks"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["sql", "injection", "database", "critical"])
        ),
        (
            id: Some("python-sql-injection-002"),
            name: Some("SQL Injection via String Concatenation"),
            category: Some("injection"),
            mode: "search",
            patterns: Some([
                "*cursor.execute*+*",
                "*execute*+*",
                "*SELECT*+*",
                "*INSERT*+*",
                "*UPDATE*+*",
                "*DELETE*+*"
            ]),
            finding_type: Some("SQL Injection"),
            severity: Some("Critical"),
            confidence: Some("High"),
            description: Some("SQL query constructed using string concatenation, which is vulnerable to SQL injection attacks"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["sql", "injection", "database", "critical"])
        ),
        (
            id: Some("python-sql-execution-general"),
            name: Some("SQL Execution"),
            category: Some("database"),
            mode: "search",
            patterns: Some([
                "*cursor.execute*",
                "*connection.execute*",
                "*db.execute*",
                "*session.execute*"
            ]),
            finding_type: Some("SQL Execution"),
            severity: Some("Medium"),
            confidence: Some("Medium"),
            description: Some("SQL execution detected - ensure parameterized queries are used to prevent injection"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["sql", "database", "execution"])
        ),
        (
            id: Some("python-sql-dangerous-keywords"),
            name: Some("Dangerous SQL Keywords"),
            category: Some("injection"),
            mode: "search",
            patterns: Some([
                "*DROP TABLE*",
                "*DELETE FROM*",
                "*TRUNCATE*",
                "*ALTER TABLE*",
                "*CREATE TABLE*",
                "*UNION SELECT*",
                "*; DROP*",
                "*; DELETE*"
            ]),
            finding_type: Some("Dangerous SQL"),
            severity: Some("High"),
            confidence: Some("High"),
            description: Some("Dangerous SQL keywords detected that could indicate SQL injection attempts"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["sql", "dangerous", "injection"])
        )
    ]
)