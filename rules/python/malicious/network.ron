{
    malware_detection: Some([
        // Network backdoor/reverse shell patterns
        (
            patterns: [
                "socket.socket",
                "socket.create_connection"
            ],
            finding_type: Some("backdoor"),
            severity: Some("high"),
            confidence: Some("medium"),  // More realistic confidence
            conditions: Some([
                // Look for backdoor patterns
                (
                    type: "has_argument",
                    patterns: Some([
                        "*bind*", "*listen*", "*accept*",
                        "*shell*", "*cmd*", "*reverse*"
                    ]),
                ),
                // Exclude normal client connections
                (
                    type: "argument_not_sanitized",
                    patterns: Some([
                        "*http*", "*https*", "*api*", "*service*"
                    ]),
                ),
                // Exclude hardcoded values
                (
                    type: "not_literal",
                    argument_position: Some(0),
