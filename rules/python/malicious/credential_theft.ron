{
    malware_detection: Some([
        // Browser credential stealing from database files
        (
            patterns: [
                "sqlite3.connect",
                "sqlite3.Connection",
            ],
            finding_type: Some("credential_theft"),
            severity: Some("high"),
            confidence: Some("medium"),
            conditions: Some([
                // Look for browser database files
                (
                    type: "has_argument",
                    patterns: Some([
                        "*Login Data*", 
                        "*Cookies*", 
                        "*Web Data*",
                        "*History*",
                        "*.mozilla*",
                        "*Chrome*",
                        "*Firefox*",
                        "*Edge*",
                        "*Opera*"
                    ]),
                ),
                // Not in test files
                (type: "in_context", not_in: Some(["comment", "string_literal"])),
            ]),
            file_types: Some((
                extensions: [".py", ".pyw"],
                include_patterns: None,
                exclude_patterns: Some(["*test*", "*example*", "*demo*"]),
            )),
        ),
        
