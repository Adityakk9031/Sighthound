{
    malware_detection: Some([
        // File system manipulation - suspicious file creation
        (
            pattern: "open",
            finding_type: Some("suspicious_file_creation"),
            severity: Some("high"),
            confidence: Some("medium"),
            conditions: Some([
                (
                    type: "has_argument",
                    patterns: Some(["*C:\\\\Windows\\\\System32*", "*system32*", "*/etc/passwd*"]),
                ),
                (
                    type: "not_in_protective_context",
                ),
                (
                    type: "not_literal",
                    argument_position: Some(0),
                ),
            ]),
            sanitizers: Some([
                "*os.path.join*", "*pathlib.Path*", "*abspath*"
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: None,
                exclude_patterns: Some(["*test*"]),
            )),
        ),
        // Mass file operations (potential ransomware)
        (
            patterns: ["os.walk", "glob.glob", "pathlib.Path.glob"],
            finding_type: Some("mass_file_operation"),
            severity: Some("high"),
            confidence: Some("medium"),
            conditions: Some([
                (
                    type: "has_argument",
                    patterns: Some(["*encrypt*", "*crypt*", "*ransom*"]),
                ),
                (
                    type: "not_in_protective_context",
                ),
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: None,
                exclude_patterns: Some(["*test*", "*backup*"]),
            )),
        ),
        // Suspicious temporary file creation and execution
        (
            pattern: "tempfile.NamedTemporaryFile",
            finding_type: Some("suspicious_file_execution"),
            severity: Some("medium"),
            confidence: Some("medium"),
            conditions: Some([
                (
                    type: "has_argument",
                    pattern: Some("*delete=False*"),
                ),
                (
                    type: "has_sibling_pattern",
                    patterns: Some(["*exec*", "*subprocess*", "*Popen*", "*system*"]),
                ),
                (
                    type: "not_in_protective_context",
                ),
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: None,
                exclude_patterns: Some(["*test*"]),
            )),
        ),
        // Sensitive file search by keywords
        (
            patterns: ["os.listdir", "glob.glob", "os.scandir", "pathlib.Path.glob"],
            finding_type: Some("file_exfiltration"),
            severity: Some("medium"),
            confidence: Some("low"),
            conditions: Some([
                (
                    type: "has_sibling_pattern",
                    patterns: Some(["*wallet*", "*password*", "*secret*", "*credential*", "*key*"]),
                ),
                (
                    type: "has_sibling_pattern",
                    patterns: Some(["*upload*", "*send*", "*post*", "*request*", "*ftp*", "*socket*"]),
                ),
                (
                    type: "not_in_protective_context",
                ),
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: None,
                exclude_patterns: Some(["*test*", "*backup*"]),
            )),
        ),
    ]),
