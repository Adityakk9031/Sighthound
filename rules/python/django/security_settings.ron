{
    hardcoded_secrets: Some([
        // Hardcoded SECRET_KEY in settings
        (
            pattern: "SECRET_KEY",
            finding_type: Some("django_hardcoded_secret_key"),
            severity: Some("critical"),
            confidence: Some("high"),
            conditions: Some([
                // Must be an assignment with literal value
                (type: "has_argument", patterns: Some([
                    "*=*", "*\"*", "*'*"
                ])),
                
                // Not using environment variables or key management
                (type: "argument_not_sanitized", patterns: Some([
                    "*os.environ*", "*getenv*", "*config*", "*secrets*"
                ])),
                
                // Exclude test settings
                (type: "in_context", not_in: Some(["comment"])),
            ]),
            sanitizers: Some([
                "os.environ.get",
                "django.conf.settings",
                "decouple.config"
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: Some(["*settings*"]),
            )),
        ),
        
        // Database credentials in settings
        (
            patterns: [
                "DATABASES",
                "DATABASE_URL"
            ],
            finding_type: Some("django_hardcoded_db_credentials"),
            severity: Some("high"),
            confidence: Some("medium"),
            conditions: Some([
                // Contains hardcoded passwords/credentials
                (type: "has_argument", patterns: Some([
                    "*PASSWORD*", "*password*", "*USER*", "*user*",
                    "*HOST*", "*host*"
                ])),
                
                // Not using environment variables
                (type: "argument_not_sanitized", patterns: Some([
                    "*os.environ*", "*getenv*", "*config*"
                ])),
            ]),
            sanitizers: Some([
                "os.environ.get",
                "decouple.config"
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: Some(["*settings*"]),
            )),
        ),
    ]),
    
    crypto_rules: Some([
        // Debug mode in production
        (
            pattern: "DEBUG",
            finding_type: Some("django_debug_in_production"),
            severity: Some("high"),
            confidence: Some("medium"),
            conditions: Some([
                // DEBUG = True
                (type: "has_argument", patterns: Some([
                    "*=*True*", "*= True*"
                ])),
                
                // Not properly configured for environment
                (type: "argument_not_sanitized", patterns: Some([
                    "*os.environ*", "*getenv*", "*config*", "*False*"
                ])),
            ]),
            sanitizers: Some([
                "os.environ.get",
                "decouple.config"
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: Some(["*settings*"]),
            )),
        ),
        
        // Insecure ALLOWED_HOSTS
        (
            pattern: "ALLOWED_HOSTS",
            finding_type: Some("django_insecure_allowed_hosts"),
            severity: Some("medium"),
            confidence: Some("medium"),
            conditions: Some([
                // Contains wildcard or overly broad hosts
                (type: "has_argument", patterns: Some([
                    "*\"*\"*", "*'*'*", "*\\**", "*.*"
                ])),
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: Some(["*settings*"]),
            )),
        ),
        
        // Missing security middleware
        (
            pattern: "MIDDLEWARE",
            finding_type: Some("django_missing_security_middleware"),
            severity: Some("medium"),
            confidence: Some("low"),
            conditions: Some([
                // Check for missing critical security middleware
                (type: "argument_not_sanitized", patterns: Some([
                    "*SecurityMiddleware*", "*CSRFViewMiddleware*",
                    "*ClickjackingMiddleware*", "*XFrameOptionsMiddleware*"
                ])),
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: Some(["*settings*"]),
            )),
        ),
        
        // Weak Django signing algorithm
        (
            patterns: [
                "django.core.signing.Signer",
                "django.core.signing.TimestampSigner"
            ],
            finding_type: Some("django_weak_signing"),
            severity: Some("medium"),
            confidence: Some("medium"),
            conditions: Some([
                // Using weak algorithms
                (type: "has_argument", patterns: Some([
                    "*algorithm=\"md5\"*", "*algorithm='md5'*",
                    "*algorithm=\"sha1\"*", "*algorithm='sha1'*"
                ])),
            ]),
            sanitizers: Some([
                "sha256", "sha512"
            ]),
            file_types: Some((
                extensions: [".py"],
                include_patterns: None,
            )),
        ),
    ]),
} 