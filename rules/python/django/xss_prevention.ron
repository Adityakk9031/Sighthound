{
    xss_prevention_rules: [
        // Django HttpResponse with user input - XSS risk
        (
            pattern: "HttpResponse",
            finding_type: "django_xss",
            severity: "high",
            confidence: "medium",
            file_types: (
                extensions: [".py"],
                include_patterns: ["*views*", "*controller*"],
            ),
        ),
        // render_to_string without escaping
        (
            pattern: "render_to_string",
            finding_type: "django_xss",
            severity: "medium",
            confidence: "medium",
            file_types: (
                extensions: [".py"],
            ),
        ),
        // Django mark_safe with user input
        (
            pattern: "mark_safe",
            finding_type: "django_xss_mark_safe",
            severity: "high",
            confidence: "medium",
            file_types: (
                extensions: [".py"],
                include_patterns: ["*views*", "*templates*", "*utils*"],
            ),
        ),
        // Template context without autoescape
        (
            patterns: [
                "django.template.Context",
                "*.render_to_response"
            ],
            finding_type: "django_template_xss",
            severity: "medium",
            confidence: "medium",
            file_types: (
                extensions: [".py"],
                include_patterns: ["*views*", "*context_processors*"],
            ),
        ),
        // Direct template string rendering with user input
        (
            patterns: [
                "django.template.Template",
                "Template.render"
            ],
            finding_type: "django_template_injection",
            severity: "high", 
            confidence: "high",
            file_types: (
                extensions: [".py"],
            ),
        ),
        // Unsafe mark_safe usage
        (
            pattern: "django.utils.safestring.mark_safe",
            finding_type: "django_unsafe_mark_safe",
            severity: "medium",
            confidence: "medium",
            file_types: (
                extensions: [".py"],
            ),
        ),
    ],
}